APP_NAME=ProFin Core Investment Platform
APP_VERSION=2.0.0
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg2://profin:profin_dev@db:5432/profin_core
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
PROTOTYPE_AUTO_APPROVE_SUBSCRIPTIONS=true

# Copiez ce fichier vers .env et renseignez votre clé locale.
# Ne commitez jamais .env ni une clé OpenRouter réelle.
AI_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_TIMEOUT_SECONDS=20
OPENROUTER_MAX_TOKENS=500
